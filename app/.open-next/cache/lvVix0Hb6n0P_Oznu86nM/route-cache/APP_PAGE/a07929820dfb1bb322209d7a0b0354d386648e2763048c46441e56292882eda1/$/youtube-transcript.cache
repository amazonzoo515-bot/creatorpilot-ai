h2\\\",null,{\\\"className\\\":\\\"text-3xl font-bold tracking-tight text-gray-900\\\",\\\"children\\\":\\\"How to Get a YouTube Video Transcript\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"mt-4 list-decimal space-y-3 pl-6 leading-7 text-gray-600\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Open the video on YouTube and copy its link from the address bar or the Share button.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Paste the link into the box at the top of this page and press Get Transcript.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Read the text, switch timestamps on if you need them, then copy it or download the .txt file.\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-6 leading-8 text-gray-600\\\",\\\"children\\\":\\\"Normal watch links, youtu.be short links and YouTube Shorts links all work. You can also paste the 11-character video ID on its own.\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"mt-10 text-2xl font-bold text-gray-900\\\",\\\"children\\\":\\\"What People Use a Video Transcript For\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 leading-8 text-gray-600\\\",\\\"children\\\":\\\"Most people want to skim a long video without watching all of it, pull out a quote, or keep notes from a lecture or tutorial. Creators use transcripts to write blog posts and show notes from their own videos, and to check captions for mistakes. Researchers and students search the text for the moment a topic comes up.\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"mt-10 text-2xl font-bold text-gray-900\\\",\\\"children\\\":\\\"When a Transcript Isn't Available\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 leading-8 text-gray-600\\\",\\\"children\\\":\\\"A transcript only exists when the video has captions. If the creator switched them off, or YouTube hasn't generated automatic ones yet (this often happens right after an upload), you'll see an error instead of text. Private, deleted and region-locked videos don't work either.\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"mt-10 text-2xl font-bold text-gray-900\\\",\\\"children\\\":\\\"Need the Video's Thumbnail Too?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 leading-8 text-gray-600\\\",\\\"children\\\":[\\\"The thumbnail shown with each transcript is a preview. For the full-size file in HD, SD, HQ and other sizes, paste the same link into the\\\",\\\" \\\",[\\\"$\\\",\\\"$L2\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"font-medium text-red-600 underline underline-offset-2 hover:text-red-700\\\",\\\"children\\\":\\\"YouTube Thumbnail Downloader\\\"}],\\\".\\\"]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mx-auto mt-16 max-w-4xl rounded-2xl bg-white p-8 shadow-sm md:p-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-3xl font-bold tracking-tight text-gray-900\\\",\\\"children\\\":\\\"Frequently Asked Questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8 grid gap-8 md:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"article\\\",\\\"How do I get the transcript of a YouTube video?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"How do I get the transcript of a YouTube video?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"Copy the video's link, paste it into the box above and press Get Transcript. The text appears below the video thumbnail, and you can copy it or download it as a .txt file.\\\"}]]}],\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\"]}]]}]]}]}],\\\"$L17\\\",\\\"$L18\\\"]\\na:[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/23p7n_1bmtxg_.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]\\nb:[\\\"$\\\",\\\"$L19\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$1a\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@1b\\\"}]}]\\nd:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L1c\\\",null,{\\\"children\\\":\\\"$L1d\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$L1e\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$1a\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$L1f\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}]\\nf:[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/2x--3ngs7fi5t.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]\\nc:C\\n11:[\\\"$\\\",\\\"article\\\",\\\"Does this work on videos without captions?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Does this work on videos without captions?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"No. The transcript comes from the captions YouTube already has for the video, either uploaded by the creator or generated automatically. If a video has no captions, there's nothing to show, and this tool doesn't turn audio into text on its own.\\\"}]]}]\\n12:[\\\"$\\\",\\\"article\\\",\\\"Can I see timestamps in the transcript?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Can I see timestamps in the transcript?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"Yes. Switch Timestamps to ON and every line gets the time it starts. The Copy and Download buttons follow whichever mode is active.\\\"}]]}]\\n13:[\\\"$\\\",\\\"article\\\",\\\"Why does a video show an error?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Why does a video show an error?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"The usual reasons are that captions are turned off, the video is private, deleted or restricted in some regions, or YouTube is limiting requests for a few minutes. Try again later or test another video.\\\"}]]}]\\n14:[\\\"$\\\",\\\"article\\\",\\\"Which language will the transcript be in?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Which language will the transcript be in?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"It starts in the video's own caption language, which is usually the language it was spoken in. A Language list above the text lets you switch to another language.\\\"}]]}]\\n15:[\\\"$\\\",\\\"article\\\",\\\"Can I translate a YouTube transcript into another language?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Can I translate a YouTube transcript into another language?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"Yes. Pick a language from the list after the transcript loads. If the creator uploaded captions in that language you get those. Otherwise the text is translated automatically, so the wording can be rough, especially when the original captions were auto-generated. Very long videos may be too long to translate.\\\"}]]}]\\n16:[\\\"$\\\",\\\"article\\\",\\\"Can I reuse a transcript in my own content?\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-bold leading-7 text-gray-900\\\",\\\"children\\\":\\\"Can I reuse a transcript in my own content?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 leading-7 text-gray-600\\\",\\\"children\\\":\\\"A transcript is the creator's words, so it stays their copyright. It's fine for reading, notes, research and accessibility. Ask for permission before you republish it or sell it.\\\"}]]}]\\n20:T901,{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How do I get the transcript of a YouTube video?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Copy the video's link, paste it into the box above and press Get Transcript. The text appears below the video thumbnail, and you can copy it or download it as a .txt file.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Does this work on videos without captions?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"No. The transcript comes from the captions YouTube already has for the video, either uploaded by the creator or generated automatically. If a video has no captions, there's nothing to show, and this tool doesn't turn audio into text on its own.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can I see timestamps in the transcript?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes. Switch Timestamps to ON and every line gets the time it starts. The Copy and Download buttons follow whichever mode is active.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Why does a video show an error?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"The usual reasons are that captions are turned off, the video is private, deleted or restricted in some regions, or YouTube is limiting requests for a few minutes. Try again later or test another video.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Which language will the transcript be in?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It starts in the video's own caption language, which is usually the language it was spoken in. A Language list above the text lets you switch to another language.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can I translate a YouTube transcript into another language?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes. Pick a language from the list after the transcript loads. If the creator uploaded captions in that language you get those. Otherwise the text is translated automatically, so the wording can be rough, especially when the original captions were auto-generated. Very long videos may be too long to translate.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can I reuse a transcript in my own content?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"A transcript is the creator's words, so it stays their copyright. It's fine for reading, notes, research and accessibility. Ask for permission before you republish it or sell it.\\\"}}]}17:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$20\\\"}}]\\n18:[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"WebApplication\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"YouTube Transcript Generator\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://youtubethumbnails-downloader.com/youtube-transcript\\\\\\\",\\\\\\\"applicationCategory\\\\\\\":\\\\\\\"MultimediaApplication\\\\\\\",\\\\\\\"operatingSystem\\\\\\\":\\\\\\\"Any\\\\\\\",\\\\\\\"browserRequirements\\\\\\\":\\\\\\\"Requires JavaScript and a modern HTML5-compatible browser.\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"Free online tool that fetches the transcript of a YouTube video from its captions, with optional timestamps and a text download.\\\\\\\",\\\\\\\"offers\\\\\\\":{\\\\\