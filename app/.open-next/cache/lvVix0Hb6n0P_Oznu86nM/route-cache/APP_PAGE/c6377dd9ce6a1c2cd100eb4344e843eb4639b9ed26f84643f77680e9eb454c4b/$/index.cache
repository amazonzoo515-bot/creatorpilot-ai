{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}},"routeCache":{"key":"/route-cache/APP_PAGE/c6377dd9ce6a1c2cd100eb4344e843eb4639b9ed26f84643f77680e9eb454c4b/$/index","owner":{"kind":"APP_PAGE","sourceRoute":"/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fweb-app-manifest-192x192.png&amp;w=1920&